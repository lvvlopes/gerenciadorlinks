# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────
# Local PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/linkvault

# Neon (paste the connection string from neon.tech dashboard):
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/linkvault

# ─────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────
DEBUG=false
SECRET_KEY=change-this-to-a-random-secret-in-production
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# ─────────────────────────────────────────────
# LLM PROVIDERS  (configure at least one)
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
OLLAMA_BASE_URL=http://localhost:11434

# Which provider to use by default: anthropic | openai | ollama
DEFAULT_LLM_PROVIDER=anthropic

# Models (change if you want a different version)
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_MODEL=gpt-4o-mini
OLLAMA_MODEL=llama3.2
